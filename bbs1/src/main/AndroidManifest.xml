<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Not requested by any code this app calls yet: `:designsys` carries `:core` with it, whose
        image data-usage policy reads the active network, and lint checks that whole classpath
        against this manifest. A normal permission, granted at install.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Cleartext is allowed app-wide because the address field is the app: normalizeInstanceUrl
        accepts an explicit http:// exactly so a self-hosted LAN site can be added, and the API-28
        default (blocked) would make that site fail with a connection error that looks like a bug.
        Typing http:// is the user's own call, the same way it is in a browser.

        Backup is on without exclusions — the only state is site URLs the user typed, which is
        exactly what should survive onto a new device. The moment a credential or cached content
        appears, revisit this the way `:app` did (backup_rules.xml).
    -->
    <application
        android:name=".Bbs1App"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/bbs1_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bbs1">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
