<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Not requested by any code this app calls yet: `:designsys` carries `:core` with it, whose
        image data-usage policy reads the active network, and lint checks that whole classpath
        against this manifest. A normal permission, granted at install.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Cleartext is allowed app-wide because the address field is the app: normalizeInstanceUrl
        accepts an explicit http:// exactly so a self-hosted LAN site can be added, and the API-28
        default (blocked) would make that site fail with a connection error that looks like a bug.
        Typing http:// is the user's own call, the same way it is in a browser.

        Backup is on, but the login tokens are excluded. The site URLs the user typed are exactly
        what should survive onto a new device; the bearer token each site issued to *this* device is
        exactly what should not, which is why the two live in separate DataStore files.
        See res/xml/bbs1_backup_rules.xml and res/xml/bbs1_data_extraction_rules.xml.
    -->
    <application
        android:name=".Bbs1App"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/bbs1_backup_rules"
        android:dataExtractionRules="@xml/bbs1_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/bbs1_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bbs1">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
