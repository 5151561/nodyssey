<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API 30 and below. `data_extraction_rules.xml` supersedes this from API 31 on, so
    the two files have to stay in agreement — the exclusions below mirror it exactly.

    minSdk is 26, so this file still applies on real devices and is not dead weight.
-->
<full-backup-content>
    <!-- All Room tables are re-downloadable caches and may contain signed-in-only content. -->
    <exclude domain="database" path="." />
    <!-- WebView stores cookies under getDataDir(), which is the backup "root" domain. -->
    <exclude domain="root" path="app_webview" />
    <exclude domain="root" path="webview" />
</full-backup-content>
