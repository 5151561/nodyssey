<?xml version="1.0" encoding="utf-8"?>
<!--
  繁體中文 for the four strings the *platform* reads rather than a screen. See `values/strings.xml`
  for what each one is and why it is here rather than in `:ui`.

  `app_name` is not in this file or the English one: it is a name, and a name does not translate.

  Keyed by region for the same reason `:designsys` and `:ui` are — one convention across the three
  resource systems this app draws from, and a Traditional device is narrowed to `zh-TW` before any
  of them is asked. See `AndroidAppLanguage`.
-->
<resources>
    <string name="notifications_interactions">互動</string>
    <string name="notifications_messages">私訊</string>
    <plurals name="notify_body_interactions">
        <item quantity="other">%1$d 則新互動</item>
    </plurals>
    <plurals name="notify_body_messages">
        <item quantity="other">%1$d 則新私訊</item>
    </plurals>
    <string name="notifications_keyword_alerts">關鍵詞提醒</string>
    <string name="notifications_tracked_threads">追蹤新回覆</string>
    <string name="notify_keyword_title">新帖含「%1$s」</string>
    <plurals name="notify_body_tracked_thread">
        <item quantity="other">%1$d 則新回覆</item>
    </plurals>
    <string name="share_to_composer">發新帖</string>
    <string name="process_text_search">在 NodeSeek 搜尋</string>
    <string name="shortcut_search">搜尋</string>
    <string name="shortcut_search_long">搜尋帖子和使用者</string>
    <string name="shortcut_compose">發帖</string>
    <string name="shortcut_compose_long">發一個新帖</string>
    <string name="shortcut_notifications">通知</string>
    <string name="shortcut_notifications_long">查看通知</string>
    <string name="shortcut_sign_in_random">隨機簽到</string>
    <string name="shortcut_sign_in_random_long">今日簽到：隨機雞腿</string>
    <string name="shortcut_sign_in_fixed">固定簽到</string>
