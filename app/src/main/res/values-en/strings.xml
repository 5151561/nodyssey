<?xml version="1.0" encoding="utf-8"?>
<!--
  English for the four strings the *platform* reads rather than a screen. See `values/strings.xml`
  for what each one is and why it is here rather than in `:ui`.

  `app_name` is absent on purpose: it is a name, and a name does not translate.

  The channel names are what the system settings list this app's notifications under, so they are
  the reader's words for the two things the app notifies about — not the site's own labels.
-->
<resources>
    <string name="notifications_interactions">Interactions</string>
    <string name="notifications_messages">Direct messages</string>
    <plurals name="notify_body_interactions">
        <item quantity="one">%1$d new interaction</item>
        <item quantity="other">%1$d new interactions</item>
    </plurals>
    <plurals name="notify_body_messages">
        <item quantity="one">%1$d new direct message</item>
        <item quantity="other">%1$d new direct messages</item>
    </plurals>
    <string name="notifications_keyword_alerts">Keyword alerts</string>
    <string name="notifications_tracked_threads">Followed threads</string>
    <string name="notify_keyword_title">New thread: “%1$s”</string>
    <plurals name="notify_body_tracked_thread">
        <item quantity="one">%1$d new reply</item>
        <item quantity="other">%1$d new replies</item>
    </plurals>
    <string name="share_to_composer">New post</string>
    <string name="process_text_search">Search NodeSeek</string>
    <string name="shortcut_search">Search</string>
    <string name="shortcut_search_long">Search posts and users</string>
    <string name="shortcut_compose">New post</string>
    <string name="shortcut_compose_long">Write a new post</string>
    <string name="shortcut_notifications">Notifications</string>
    <string name="shortcut_notifications_long">Open notifications</string>
</resources>
