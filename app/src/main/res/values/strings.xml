<!--
  What is left in `:app`'s Android resources after step D1: the four strings the *platform* reads
  rather than a screen — the launcher label out of the manifest, and the three notification channel
  names, which `NotificationManager` stores at channel-creation time — plus the three notification
  bodies, which only the poll worker builds.

  The three channel names and `app_name` also exist in `ui/src/commonMain/composeResources`. That is
  a copy, and deliberately so: the settings screen draws the same names, and the alternative is
  `runBlocking { getString(…) }` inside `Application.onCreate` to reach a suspend accessor.
-->
<resources>
    <string name="app_name">Nodyssey</string>
    <string name="notifications_mentions">@我</string>
    <string name="notifications_replies">回复主题</string>
    <string name="notifications_messages">私信</string>
    <string name="notify_body_mentions">%1$d 条新的 @ 提醒</string>
    <string name="notify_body_replies">%1$d 条新回复</string>
    <string name="notify_body_messages">%1$d 条新私信</string>
</resources>
