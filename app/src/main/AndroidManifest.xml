<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Requested at runtime from the notification settings screen (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        应用内更新. This app is published as an APK on GitHub Releases, not through a store, so the
        update it offers is an APK it downloaded and handed to the platform installer. Declaring the
        permission does not grant it: the user still turns "allow from this source" on per app, and
        the system still shows its own install confirmation. See platform/ApkInstaller.kt.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Makes the installed browsers visible to `CustomTabsClient.getPackageName`, which is what
        `CustomTabsWarmer` asks before it can bind the browser's Custom Tabs service and warm it up.
        Without this the query comes back empty on API 30+ — package visibility hides every browser
        from us — and every link opens the way it used to: browser process cold-started at the moment
        of the tap, DNS not started until it exists.

        Declared here rather than in :designsys, which is where the code is: a library manifest would
        merge the same element, but this is the only Android application in the build and the entry
        is a statement about what *this* app looks up.
    -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!--
            Not for launching anything — every link this app opens goes out through a Custom Tab or
            the platform handler, neither of which needs to see the resolver list. This is so 网络自检
            can *name* the browser that would answer, beside the Custom Tabs provider above. Readers
            compare "in the app" against "in the browser" without knowing those can be two different
            packages, and on a phone routing traffic per application that difference is the whole
            explanation. Without this entry API 30+ answers null for a browser that is installed.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!--
        Backup is on, but the WebView profile is excluded. Backing it up would put the session cookie
        obtained by signing in into a cloud backup and onto any restored device — a credential leaving
        the device it was issued to. The Room cache is excluded too because it can contain content
        fetched from signed-in-only boards; settings remain safe to carry over.
        See res/xml/backup_rules.xml and res/xml/data_extraction_rules.xml.
    -->
    <application
        android:name=".NodysseyApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nodyssey">
        <!--
            adjustResize belongs on the activity; on <application> the platform never reads it, so
            the window fell back to the default pan. Panning slides the whole window out of the top
            of the screen and reports the keyboard as an inset anyway, which is what made every
            `imePadding` in the app subtract a second keyboard.
        -->
        <!--
            singleTask so that a notification tap and a site link both land in the one instance that
            is already running, through onNewIntent, instead of stacking a second copy of the app.
            The notification's PendingIntent carries only FLAG_ACTIVITY_NEW_TASK, which under the
            default launch mode merely brought the existing task forward without delivering the
            intent — so tapping it while the app was open never did switch to 通知.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Site links the app can open on a screen of its own — and only those. A board page or
                the sign-in page would come in here too if the filter were the whole host, and all
                the app could do with one is hand it to a web view, which is what the browser was
                already doing better.

                No android:autoVerify — hence the suppressed AppLinkWarning. Verification needs an
                assetlinks.json under nodeseek.com, and that domain is not ours to publish to; the
                attribute would only make the system try, fail, and log about it every install. So
                this stays an ordinary deep link and the system asks the user which app to use the
                first time.

                The <data> path forms combine with both hosts — the elements are matched as a
                cross product, not as a list of whole URLs. Kept in step with
                NodeSeekSite.parseInternalRoute, which is what actually turns the URL into a screen:
                POST_PATH `/post-<id>[-<page>]`, SPACE_PATH `/space/<uid>`, `/member?t=<name>` and
                `/notification`.

                `/notification` is admitted as a bare path because everything that distinguishes one
                notification screen from another lives after the `#` — `#/atMe`, `#/message?mode=talk
                &to=<uid>` — and a fragment is the one part of a URL these filters cannot match on.
                It arrives on the intent intact, so the telling apart happens in parseInternalRoute.
            -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="www.nodeseek.com" />
                <data android:host="nodeseek.com" />
                <data android:pathPrefix="/post-" />
                <data android:pathPrefix="/space/" />
                <data android:path="/member" />
                <data android:path="/notification" />
            </intent-filter>
        </activity>

        <!--
            Where an install session reports back: the system's confirmation screen on the way out,
            the outcome on the way back. Not exported — the only sender is our own PendingIntent.
        -->
        <receiver
            android:name=".platform.ApkInstallResultReceiver"
            android:exported="false" />

        <!-- WorkManager initializes on demand via NodysseyApp (Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
