*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
# Unanchored as well, so a new module's output is ignored without anyone remembering to add a
# `.gitignore` to it. `app/.gitignore` was the only thing covering module output before, which meant
# the first module added after it committed its entire build directory.
build/
/captures

# Heap dumps a Gradle OOM leaves behind, which are ~1 GB each.
*.hprof
.externalNativeBuild
.cxx
local.properties

# 本地笔记：接口清单与抓取策略，不对外发布
docs/private/

# Byproduct of `./gradlew resolveAndLockAll --write-locks`: Gradle also writes lock state for the
# settings-level configurations, which here resolve nothing (`empty=incomingCatalogForLibs0`).
# app/gradle.lockfile is the one that matters and is committed.
settings-gradle.lockfile

# Kotlin Gradle 插件的会话草稿目录，每次构建都会重新生成
.kotlin/

# Claude Code 的每机器状态。此前只靠本机的全局 gitignore 和 .git/info/exclude 挡着，
# 换台机器克隆就漏了，所以规则写进仓库。launch.json 是共用的预览服务器定义，有意提交，
# 因此单独放行，而不是整个目录一刀切。
.claude/*
!.claude/launch.json

# 设计稿与 Claude Design 同步产物，只在本地保留
/design/
/ds-bundle/
/ns-bundle/
/.design-sync/
