<?xml version="1.0" encoding="utf-8"?>
<!--
  Wording that belongs to the shared components, not to any one app.

  A Markdown toolbar labels the same eleven keys whichever forum it is editing for, so the labels
  travel with the toolbar. Anything naming a site, a board or a currency stays in the app module.
-->
<resources>
    <!-- Toolbar keys. Content descriptions, so they read as the action the key performs. -->
    <string name="composer_format_bold">加粗</string>
    <string name="composer_format_italic">斜体</string>
    <string name="composer_format_strikethrough">删除线</string>
    <string name="composer_format_heading">二级标题</string>
    <string name="composer_format_code">行内代码</string>
    <string name="composer_format_quote">引用</string>
    <string name="composer_format_list">无序列表</string>
    <string name="composer_format_link">链接</string>
    <string name="composer_format_mention">提到某人</string>
    <string name="composer_format_image">图片</string>
    <string name="composer_format_emoji">表情</string>

    <!-- The wrench at the end of a composer strip, and the panel it opens -->
    <string name="composer_toolbar_customize">自定义工具栏</string>
    <string name="composer_toolbar_enabled">工具栏上的按键</string>
    <string name="composer_toolbar_available">可添加</string>
    <string name="composer_toolbar_reorder">拖动排序</string>
    <string name="composer_toolbar_remove">移出工具栏</string>
    <string name="composer_toolbar_add">加入工具栏</string>
    <string name="composer_toolbar_reset">恢复默认</string>

    <!-- The emoji panel's own chrome. Which stickers it shows belongs to the app that has them, and
         so does the sentence shown when a group is empty — that one is a parameter. -->
    <string name="composer_emoji_recent">最近使用</string>
    <string name="composer_emoji_backspace">删除</string>
    <!-- The post renderer: images, code blocks, quote-reply chips, the poll placeholder. Nothing here
         names a site, a board or a currency; that copy stays in the app module.

         Prefixed rather than sharing a name with the app's own 重试 / 复制: resource merging lets an
         application module silently override a library's string of the same name, so a shared name
         would make this file look editable when it is not. -->
    <string name="richtext_image_loading">图片加载中…</string>
    <!-- Stands in for an image met where only text can go — running prose whose alt text is blank. -->
    <string name="richtext_image_label">图片</string>
    <string name="richtext_image_view_full">点击查看全图</string>
    <string name="richtext_image_load_failed">图片加载失败</string>
    <!-- The second line under 图片加载失败: why it failed, in terms of what the reader can do next.
         See ImageLoadFailure — a challenge is worth its own wording because retrying cannot fix it
         and opening the image in a browser can. -->
    <string name="richtext_image_failed_challenge">图床要求人机验证，App 过不去（HTTP %1$d）</string>
    <string name="richtext_image_failed_http">图床拒绝了这张图（HTTP %1$d）</string>
    <string name="richtext_image_failed_unreachable">连不上图床，检查一下网络</string>
    <string name="richtext_image_failed_timeout">连接图床超时</string>
    <string name="richtext_image_failed_connection">连接中断</string>
    <string name="richtext_action_retry">重试</string>
    <string name="richtext_action_open_in_browser">用浏览器打开</string>
    <string name="richtext_code_copied">代码已复制</string>
    <string name="richtext_action_copy">复制</string>
    <string name="richtext_quote_reply">@%1$s %2$s</string>
    <string name="richtext_sticker_description">表情</string>
    <!-- Names the 「仅 Wi-Fi 加载图片」 setting by its label. An app consuming this module signs up
         to calling that setting the same thing; one that names it differently has to override this
         copy, not hope nobody notices the mismatch. -->
    <string name="richtext_image_skipped_title">已开启「仅 Wi-Fi 加载图片」，当前不是 Wi-Fi</string>
    <string name="richtext_image_skipped_action">点按加载这张图</string>
    <string name="richtext_poll_title">投票</string>
    <string name="richtext_poll_body">在帖子里查看并参与</string>
    <!-- 折叠 with an empty <summary>. The browser labels such a block "详细信息"; this says what the
         reader gets by tapping instead, because unlike a browser we have room for nothing else. -->
    <string name="richtext_fold_title_fallback">折叠内容</string>
    <string name="richtext_fold_expand">展开</string>
    <string name="richtext_fold_collapse">收起</string>

    <!-- 收款码. "Ref ID" stays in the site's own Latin form: it is what the payee typed into the
         generator and what they will look for in their ledger, so translating it would break the
         one string that has to match on both ends of a payment. -->
    <string name="richtext_stardust_ref_id">Ref ID %1$d</string>
    <string name="richtext_stardust_onetime">一次性</string>
</resources>
