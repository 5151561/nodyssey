<?xml version="1.0" encoding="utf-8"?>
<!--
  繁體中文. The Traditional half of the shared components' wording; `values/strings.xml` holds the
  Simplified original and every comment explaining what a string is for.

  Keyed by region rather than by script — `values-zh-rTW` and not `values-b+zh+Hant` — because
  Compose Resources prefers a region-less `zh` bundle over the unqualified default for *every*
  Chinese environment, including the Simplified ones. `isTraditionalChineseTag` in `:shared` carries
  the other half of that trade: it is what turns a `zh-Hant-HK` device into the `zh-TW` this file
  answers to.
-->
