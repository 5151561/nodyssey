<?xml version="1.0" encoding="utf-8"?>
<!-- Self-instrumenting tests target their own package, so Android's package-visibility filtering
     hides the app under test from them; the query is what lets the launch intent resolve. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="io.github.nodyssey" />
    </queries>
</manifest>
